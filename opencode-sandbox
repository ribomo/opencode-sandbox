#!/usr/bin/env bash
# Run Opencode inside a bubblewrap sandbox, isolating it from the host system
# while selectively exposing only the resources it needs.

set -euo pipefail

# Minimal fallback PATH inside the sandbox.
default_path="/usr/local/bin:/usr/bin:/bin"
temporary_ssh_agent_started=0

# Print an error message to stderr and exit.
die() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

# Check that a required command is available, showing optional help text.
require_cmd() {
  local command_name="$1"
  local help_text="${2:-}"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    if [[ -n "$help_text" ]]; then
      die "Missing required command: $command_name. $help_text"
    fi
    die "Missing required command: $command_name"
  fi
}

# Bail early if we are not on Linux (bubblewrap is Linux-only).
require_linux() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    die "This wrapper only supports Linux because it relies on bubblewrap."
  fi
}

# Verify the host has both bubblewrap and Opencode installed.
require_runtime() {
  require_linux
  require_cmd bwrap "Install bubblewrap with your system package manager."
  require_cmd opencode "Install Opencode before using this wrapper."
}

# Report whether the current SSH agent exists and has at least one identity.
ssh_agent_has_identities() {
  [[ -n "${SSH_AUTH_SOCK:-}" ]] || return 1
  [[ -S "$SSH_AUTH_SOCK" ]] || return 1
  ssh-add -l >/dev/null 2>&1
}

# Pick the first conventional private key path that exists on the host.
find_default_ssh_identity() {
  local identity_file
  local identity_files=(
    "$HOME/.ssh/id_ed25519"
    "$HOME/.ssh/id_ecdsa"
    "$HOME/.ssh/id_rsa"
  )

  for identity_file in "${identity_files[@]}"; do
    if [[ -f "$identity_file" ]]; then
      printf '%s\n' "$identity_file"
      return 0
    fi
  done

  return 1
}

# Start a temporary host-side SSH agent when no usable agent is available.
# The private key is loaded before sandboxing and is never mounted inside.
ensure_ssh_agent() {
  local identity_file
  local agent_dir

  if ssh_agent_has_identities; then
    return 0
  fi

  identity_file="$(find_default_ssh_identity || true)"
  if [[ -z "$identity_file" ]]; then
    printf 'Warning: no SSH agent identities and no default SSH key found; SSH Git operations may fail.\n' >&2
    return 0
  fi

  if ! command -v ssh-agent >/dev/null 2>&1 || ! command -v ssh-add >/dev/null 2>&1; then
    printf 'Warning: ssh-agent or ssh-add not found; SSH Git operations may fail.\n' >&2
    return 0
  fi

  agent_dir="$sandbox_root/ssh-agent/$$"
  mkdir -p "$agent_dir"
  chmod 700 "$sandbox_root/ssh-agent" "$agent_dir"
  rm -f "$agent_dir/socket"

  eval "$(ssh-agent -a "$agent_dir/socket" -s)" >/dev/null
  temporary_ssh_agent_started=1

  if ! ssh-add "$identity_file"; then
    printf 'Warning: failed to add %s to the SSH agent; SSH Git operations may fail.\n' "$identity_file" >&2
  fi
}

# Stop only the temporary agent started by this wrapper.
cleanup_ssh_agent() {
  if [[ "$temporary_ssh_agent_started" -eq 1 ]]; then
    ssh-agent -k >/dev/null 2>&1 || true
  fi
}

# Avoid passphrase prompts for commands that only print metadata.
should_prepare_ssh_agent() {
  case "${1:-}" in
    -h|--help|-v|--version|completion)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

# Derive sandbox directory layout from the current working directory.
setup_project_paths() {
  project="$(pwd -P)"
  sandbox_root="$project/.sandbox"

  sandbox_home="$sandbox_root/home"
  cache_dir="$sandbox_root/cache"
  config_dir="$sandbox_root/config"
  data_dir="$sandbox_root/data"
  state_dir="$sandbox_root/state"

  user_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  user_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
}

# Resolve the real Opencode binary and detect its shebang line.
resolve_opencode_paths() {
  opencode_real="$(readlink -f "$(command -v opencode)")"
  opencode_first_line="$(head -n 1 "$opencode_real" 2>/dev/null | tr -d '\0' || true)"

  opencode_bin_dir="$(dirname "$opencode_real")"
  opencode_install_root="$(dirname "$(dirname "$opencode_real")")"
}

# If Opencode is installed via npm (shebang line references Node), expose
# Node's install root inside the sandbox so the runtime can be found.
setup_node_runtime() {
  node_install_root=""
  sandbox_path="$opencode_bin_dir:$default_path"

  if [[ "$opencode_first_line" == '#!'*node* ]]; then
    require_cmd node "This Opencode install uses a Node launcher, so node must also be on PATH."
    node_real="$(readlink -f "$(command -v node)")"
    node_install_root="$(dirname "$(dirname "$node_real")")"
    sandbox_path="$opencode_bin_dir:$node_install_root/bin:$default_path"
  fi
}

# Create the sandbox directory tree inside .sandbox/.
ensure_sandbox_dirs() {
  mkdir -p "$sandbox_home" "$cache_dir" "$config_dir" "$data_dir" "$state_dir"
  mkdir -p "$sandbox_home/.ssh"
  chmod 700 "$sandbox_home"
  chmod 700 "$sandbox_home/.ssh"
}

# Orchestrate all path-resolution and directory-creation steps.
resolve_paths() {
  setup_project_paths
  resolve_opencode_paths
  setup_node_runtime
  ensure_sandbox_dirs
}

# Add a read-only bind-mount for the given host path, but only if it is not
# already covered by an existing mount (or an ancestor path).
add_bind_if_needed() {
  local candidate_path="$1"
  local covered_path

  [[ -n "$candidate_path" ]] || return 0

  for covered_path in "${covered_paths[@]}"; do
    if [[ "$candidate_path" == "$covered_path" || "$candidate_path" == "$covered_path"/* ]]; then
      return 0
    fi
  done

  bwrap_args+=(--ro-bind "$candidate_path" "$candidate_path")
  covered_paths+=("$candidate_path")
}

# Expose only non-secret SSH support files. Private keys stay outside the
# sandbox; Git authentication should use the forwarded SSH agent.
bind_ssh_support_files() {
  if [[ -f "$HOME/.ssh/config" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.ssh/config" "$sandbox_home/.ssh/config")
  else
    touch "$sandbox_home/.ssh/config"
  fi

  if [[ -f "$HOME/.ssh/known_hosts" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.ssh/known_hosts" "$sandbox_home/.ssh/known_hosts")
  else
    touch "$sandbox_home/.ssh/known_hosts"
  fi
}

# Build a shell-safe GIT_SSH_COMMAND with absolute sandbox paths.
build_git_ssh_command() {
  local part
  local quoted_part
  local command_parts=(
    ssh
    -F
    "$sandbox_home/.ssh/config"
    -o
    StrictHostKeyChecking=accept-new
    -o
    "UserKnownHostsFile=$sandbox_home/.ssh/known_hosts"
  )

  if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
    command_parts+=(
      -o
      "IdentityAgent=$SSH_AUTH_SOCK"
    )
  fi

  git_ssh_command=""
  for part in "${command_parts[@]}"; do
    printf -v quoted_part '%q' "$part"
    git_ssh_command+="${git_ssh_command:+ }$quoted_part"
  done
}

# Make the selected SSH agent socket reachable inside the sandbox.
bind_ssh_agent_socket() {
  [[ -n "${SSH_AUTH_SOCK:-}" ]] || return 0
  [[ -S "$SSH_AUTH_SOCK" ]] || return 0

  bwrap_args+=(--setenv SSH_AUTH_SOCK "$SSH_AUTH_SOCK")
  bwrap_args+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK")
}

# Compose the full set of bubblewrap arguments.
# This isolates the process (no network, no other namespaces besides net),
# remaps the project directory and XDG dirs into .sandbox/, and selectively
# exposes system paths, SSH config, the SSH agent socket, and Opencode/Node
# install roots.
build_bwrap_args() {
  # Track paths already covered to avoid duplicate or nested mounts.
  covered_paths=(
    /usr
    /etc
    /lib
    /lib64
    /lib32
    /usr/local/bin
    "$project"
  )

  bwrap_args=(
    --unshare-all
    --share-net
    --die-with-parent
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /run /run
    --ro-bind-try /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /lib32 /lib32
    --symlink usr/bin /bin
    --symlink usr/sbin /sbin
    --ro-bind-try /usr/local/bin /usr/local/bin
    --bind "$project" "$project"
    --setenv HOME "$sandbox_home"
    --setenv XDG_CONFIG_HOME "$config_dir"
    --setenv XDG_CACHE_HOME "$cache_dir"
    --setenv XDG_DATA_HOME "$data_dir"
    --setenv XDG_STATE_HOME "$state_dir"
    --setenv TMPDIR /tmp
    --setenv PATH "$sandbox_path"
    --chdir "$project"
  )

  # Expose host SSH config and known_hosts only. Private keys are never
  # mounted into the sandbox.
  # Always use -F to skip the system SSH config, which may have bad
  # ownership or permissions in sandboxed/containerized environments.
  bind_ssh_support_files

  # Forward the SSH agent socket so git operations work inside the sandbox.
  bind_ssh_agent_socket

  build_git_ssh_command
  bwrap_args+=(--setenv GIT_SSH_COMMAND "$git_ssh_command")

  add_bind_if_needed "$node_install_root"
  add_bind_if_needed "$opencode_install_root"

  # Bind per-user Opencode configuration and data directories if present.
  if [[ -d "$user_config_home/opencode" ]]; then
    mkdir -p "$config_dir/opencode"
    bwrap_args+=(--ro-bind "$user_config_home/opencode" "$config_dir/opencode")
  fi
  if [[ -d "$user_data_home/opencode" ]]; then
    mkdir -p "$data_dir/opencode"
    bwrap_args+=(--bind "$user_data_home/opencode" "$data_dir/opencode")
  fi
}

main() {
  require_runtime
  resolve_paths
  if should_prepare_ssh_agent "$@"; then
    ensure_ssh_agent
  fi
  build_bwrap_args

  if [[ "$temporary_ssh_agent_started" -eq 1 ]]; then
    trap cleanup_ssh_agent EXIT
    bwrap \
      "${bwrap_args[@]}" \
      "$opencode_real" "$@"
  else
    exec bwrap \
      "${bwrap_args[@]}" \
      "$opencode_real" "$@"
  fi
}

main "$@"
